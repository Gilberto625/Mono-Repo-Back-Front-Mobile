# Copiar a .env.e2e.local (no commitear) para pruebas Playwright contra Neon staging.
# No usar credenciales de producción ni clientes reales.

E2E_BASE_URL_FRONTEND=http://localhost:4200
E2E_BASE_URL_BACKEND=http://127.0.0.1:8000/api

E2E_STAGING_USERNAME_ADMIN=e2e_admin_stylo
E2E_STAGING_USERNAME_CLIENT=e2e_cliente_stylo
E2E_STAGING_PASSWORD=replace-with-e2e-staging-password
