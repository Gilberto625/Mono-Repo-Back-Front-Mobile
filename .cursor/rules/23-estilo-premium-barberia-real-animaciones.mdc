## 12. Scroll reveal en Angular

Cuando Cursor genere secciones de landing o páginas públicas, debe incluir patrón de scroll reveal con IntersectionObserver.

Ejemplo TypeScript:

```ts
import { AfterViewInit, Directive, ElementRef, Renderer2 } from '@angular/core';

@Directive({
  selector: '[appRevealOnScroll]',
  standalone: true,
})
export class RevealOnScrollDirective implements AfterViewInit {
  constructor(
    private readonly elementRef: ElementRef<HTMLElement>,
    private readonly renderer: Renderer2
  ) {}

  ngAfterViewInit(): void {
    const element = this.elementRef.nativeElement;

    this.renderer.addClass(element, 'reveal');

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          this.renderer.addClass(element, 'is-visible');
          observer.unobserve(element);
        }
      },
      { threshold: 0.16 }
    );

    observer.observe(element);
  }
}
```

CSS:

```scss
.reveal {
  opacity: 0;
  transform: translateY(34px) scale(.98);
  filter: blur(10px);
  transition:
    opacity 720ms cubic-bezier(.16, 1, .3, 1),
    transform 720ms cubic-bezier(.16, 1, .3, 1),
    filter 720ms cubic-bezier(.16, 1, .3, 1);
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0) scale(1);
  filter: blur(0);
}
```

