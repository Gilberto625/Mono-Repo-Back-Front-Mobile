# Copiar al .env local, a Render (Environment) o al orquestador.
# Documentación: ../docs/RASP_IMPLEMENTACION.md
#
# ── ¿Qué pide el documento RASP? ─────────────────────────────────────────────
# Para la APP Django (trazas + ASM): DD_SITE, DD_SERVICE, DD_ENV, DD_VERSION,
#   DD_TRACE_ENABLED, DD_APPSEC_ENABLED, DD_AGENT_HOST, DD_TRACE_AGENT_PORT
#   (o DD_TRACE_AGENT_URL si usas socket Unix en Docker Compose).
# DD_API_KEY es del AGENTE Datadog (docker-compose.datadog.yml), no de la app en Render salvo
#   que tengas un despliegue donde Datadog lo requiera en el mismo servicio.
# El resto de tu .env (SECRET_KEY, DATABASE_URL, Clip, JWT, etc.) NO forma parte del texto del
#   plan RASP, pero SÍ hace falta para que Django funcione en Render.
# ─────────────────────────────────────────────────────────────────────────────

# --- Datadog tracer + App and API Protection (RASP / exploit prevention) ---
# DD_API_KEY=   # solo agente: docker compose -f docker-compose.datadog.yml

DD_SITE=us5.datadoghq.com

DD_SERVICE=stylo-barber-api
DD_ENV=production
DD_VERSION=1.0.0

# Trazas APM
DD_TRACE_ENABLED=true

# App and API Protection (incluye reglas y bloqueo con políticas en Datadog)
DD_APPSEC_ENABLED=true

# Agente: TCP (Compose con puerto 8126 publicado)
DD_AGENT_HOST=dd-agent
DD_TRACE_AGENT_PORT=8126

# O bien trazas por socket Unix (mismo volumen datadog_run que dd-agent; ver docker-compose.datadog.yml)
# DD_TRACE_AGENT_URL=unix:///var/run/datadog/apm.socket

# Remote Configuration: recomendado para actualizar reglas sin redeploy
# Ver: https://docs.datadoghq.com/tracing/guide/remote_config/
